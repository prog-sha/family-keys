#!/bin/sh
set -eu
umask 077
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$base"
runtime=${KEYS_GD:-$(command -v gd || true)}
if [ -z "$runtime" ] || [ ! -x "$runtime" ]; then
  echo "gd 0.9.0 with Schema support is required. Put gd on PATH or set KEYS_GD." >&2
  exit 1
fi
action=${1:-serve}
if [ "$#" -gt 0 ]; then shift; fi
case "$action" in
  init)
    if [ -t 0 ]; then
      terminal=$(stty -g)
      trap 'stty "$terminal"' EXIT
      trap 'exit 1' HUP INT TERM
      printf 'Shared web password (12+ characters): ' >&2
      stty -echo
      IFS= read -r password
      stty "$terminal"
      printf '\n' >&2
      printf '%s\n' "$password" | "$runtime" setup.gd "$@"
    else
      exec "$runtime" setup.gd "$@"
    fi
    ;;
  serve) exec "$runtime" serve server.gd "$@" ;;
  lan) exec "$runtime" lan.gd "$@" ;;
  check) exec "$runtime" check ./*.gd tests/*.gd ;;
  *) echo "Usage: ./keys {init|serve|lan|check}" >&2; exit 1 ;;
esac
